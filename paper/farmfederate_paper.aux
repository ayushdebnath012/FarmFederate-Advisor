\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Best F1 score by model type. VLM fusion models (green) achieve the highest F1 (0.848), followed by ViT image encoders (red, 0.765), and LLM text encoders (blue, 0.590). Multimodal fusion provides a clear performance advantage over unimodal approaches.}}{11}{figure.caption.35}\protected@file@percent }
\newlabel{fig:model_overview}{{18}{11}{Best F1 score by model type. VLM fusion models (green) achieve the highest F1 (0.848), followed by ViT image encoders (red, 0.765), and LLM text encoders (blue, 0.590). Multimodal fusion provides a clear performance advantage over unimodal approaches}{figure.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces F1 score vs.\ model size (number of parameters) across all architectures. ViT models (${\sim }$5M params) achieve strong F1 (0.70--0.77), LLM models (${\sim }$11M) achieve moderate F1 (0.53--0.59), while VLM models (16--17M) reach the highest F1 (0.78--0.85), demonstrating that multimodal fusion justifies the additional parameter cost.}}{11}{figure.caption.36}\protected@file@percent }
\newlabel{fig:efficiency}{{19}{11}{F1 score vs.\ model size (number of parameters) across all architectures. ViT models (${\sim }$5M params) achieve strong F1 (0.70--0.77), LLM models (${\sim }$11M) achieve moderate F1 (0.53--0.59), while VLM models (16--17M) reach the highest F1 (0.78--0.85), demonstrating that multimodal fusion justifies the additional parameter cost}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Radar chart comparing the best model from each category (LLM, ViT, VLM) across multiple evaluation dimensions including F1, precision, recall, and parameter efficiency. VLM fusion dominates on classification metrics while ViT models lead in parameter efficiency.}}{11}{figure.caption.37}\protected@file@percent }
\newlabel{fig:radar}{{20}{11}{Radar chart comparing the best model from each category (LLM, ViT, VLM) across multiple evaluation dimensions including F1, precision, recall, and parameter efficiency. VLM fusion dominates on classification metrics while ViT models lead in parameter efficiency}{figure.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces F1 micro vs.\ macro comparison across all 18 models. The close alignment between micro and macro F1 scores confirms balanced per-class performance, with no model exhibiting significant class bias.}}{12}{figure.caption.38}\protected@file@percent }
\newlabel{fig:f1_micro_macro}{{21}{12}{F1 micro vs.\ macro comparison across all 18 models. The close alignment between micro and macro F1 scores confirms balanced per-class performance, with no model exhibiting significant class bias}{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Model feature comparison matrix summarizing architecture properties, training characteristics, and performance metrics across all 18 trained models.}}{12}{figure.caption.39}\protected@file@percent }
\newlabel{fig:model_matrix}{{22}{12}{Model feature comparison matrix summarizing architecture properties, training characteristics, and performance metrics across all 18 trained models}{figure.caption.39}{}}
