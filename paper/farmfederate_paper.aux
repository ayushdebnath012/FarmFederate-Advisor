\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Modality contribution to VLM performance. Text (sensors) contributes 40\% of the discriminative signal, vision (images) contributes 35\%, and the cross-attention fusion mechanism adds 25\%, demonstrating that both modalities provide complementary information.}}{11}{figure.caption.34}\protected@file@percent }
\newlabel{fig:modality_contribution}{{17}{11}{Modality contribution to VLM performance. Text (sensors) contributes 40\% of the discriminative signal, vision (images) contributes 35\%, and the cross-attention fusion mechanism adds 25\%, demonstrating that both modalities provide complementary information}{figure.caption.34}{}}
