\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Retrieval quality metrics (Recall@5, MRR, NDCG@5, KB Coverage) for the federated RAG pipeline over 10 training rounds. KB Coverage achieves 1.0 (all documents reachable); MRR (0.800) and NDCG@5 (0.894) both exceed the ${\geq }0.70$ target; Recall@5 (0.733) approaches but does not yet reach the ${\geq }0.85$ target due to limited hard-negative diversity in the self-supervised InfoNCE training regime.}}{9}{figure.caption.23}\protected@file@percent }
\newlabel{fig:rag_retrieval}{{6}{9}{Retrieval quality metrics (Recall@5, MRR, NDCG@5, KB Coverage) for the federated RAG pipeline over 10 training rounds. KB Coverage achieves 1.0 (all documents reachable); MRR (0.800) and NDCG@5 (0.894) both exceed the ${\geq }0.70$ target; Recall@5 (0.733) approaches but does not yet reach the ${\geq }0.85$ target due to limited hard-negative diversity in the self-supervised InfoNCE training regime}{figure.caption.23}{}}
