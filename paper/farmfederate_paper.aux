\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Centralized vs.\ federated F1 scores across LLM, ViT, and VLM model types. Federated training (orange) achieves 86--93\% of centralized performance (blue), with VLM and LLM models exhibiting the smallest federated gap.}}{9}{figure.caption.27}\protected@file@percent }
