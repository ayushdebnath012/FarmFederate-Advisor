\newlabel{eq:text_encoding}{{1}{3}{LLM Text Encoders}{equation.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces FarmFederate integrated architecture. \textbf  {Left} (Classification pipeline): text and image inputs pass through LLM and ViT encoders, are fused by the VLM module, and classified into five stress categories. \textbf  {Centre-right} (Federated server): FedAvg aggregates model updates from $K{=}3$ clients; the retriever is further stabilised via EMA ($\mu {=}0.9$). \textbf  {Right} (Federated RAG layer): the fused embedding $\mathbf  {h}_f$, class probabilities $\mathbf  {p}$, and IoT sensor readings $\mathbf  {s}$ are projected into a 128-d query; a dual-encoder retriever searches the farm-local FAISS knowledge store (never transmitted to the server); retrieved passages are assembled into context for LLM treatment advisory generation. The joint loss $\mathcal  {L}_{RAG}$ trains all four components simultaneously.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:system_architecture}{{1}{4}{FarmFederate integrated architecture. \textbf {Left} (Classification pipeline): text and image inputs pass through LLM and ViT encoders, are fused by the VLM module, and classified into five stress categories. \textbf {Centre-right} (Federated server): FedAvg aggregates model updates from $K{=}3$ clients; the retriever is further stabilised via EMA ($\mu {=}0.9$). \textbf {Right} (Federated RAG layer): the fused embedding $\mathbf {h}_f$, class probabilities $\mathbf {p}$, and IoT sensor readings $\mathbf {s}$ are projected into a 128-d query; a dual-encoder retriever searches the farm-local FAISS knowledge store (never transmitted to the server); retrieved passages are assembled into context for LLM treatment advisory generation. The joint loss $\mathcal {L}_{RAG}$ trains all four components simultaneously}{figure.caption.3}{}}
